# Copy to ".env" in the repository root (same folder as this file).
# Django loads these from the repo root via backend/config/settings.py.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for the React dev server (Vite default: 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Django origin for production builds of the React app (omit in local dev; Vite proxies /api).
# Loaded from the repo root because frontend/vite.config.ts sets envDir to "..".
# VITE_API_BASE_URL=https://your-api-host.example

# OpenAI-compatible API (required for POST /api/pattern/generate/).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL (Azure OpenAI, local proxy, etc.).
# OPENAI_BASE_URL=

# Demo safety limits.
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=10000
MAX_UPLOAD_COLUMNS=100
MAX_CELL_CHARS=2000
MAX_REGEX_PATTERN_LENGTH=500
MAX_REPLACEMENT_CHARS=10000
MAX_SAMPLE_SCAN_ROWS=250
UPLOAD_STORE_TTL_SECONDS=3600
UPLOAD_STORE_MAX_ITEMS=25
EXPORT_STORE_MAX_ITEMS=25
