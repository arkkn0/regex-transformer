# Example production environment. Copy these values into your hosting provider's
# environment variable settings; do not commit real secrets.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-backend-host.example
CORS_ALLOWED_ORIGINS=https://your-frontend-host.example

# Required when the frontend is hosted separately from Django.
# Set this before running `npm run build`.
VITE_API_BASE_URL=https://your-backend-host.example

# Required for the live natural-language generation demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Demo safety limits. Adjust only if the deployment has enough memory/CPU.
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=10000
MAX_UPLOAD_COLUMNS=100
MAX_CELL_CHARS=2000
MAX_REGEX_PATTERN_LENGTH=500
MAX_REPLACEMENT_CHARS=10000
MAX_SAMPLE_SCAN_ROWS=250
UPLOAD_STORE_TTL_SECONDS=3600
UPLOAD_STORE_MAX_ITEMS=25
EXPORT_STORE_MAX_ITEMS=25
